#!/usr/bin/env python3
"""MiMo 套餐额度缓存同步器（本地零上报）。

从 MiMo Desktop 的 xiaomi-account cookie 拿 passToken，走小米 SSO
（sid=mimopc）换 serviceToken，只读拉取官方套餐用量，写入本地缓存：

    ~/.cache/quotadock/mimo-usage.json

QuotaDock 只读该缓存文件，不碰凭据、不发额外请求。
用法: mimo-usage-sync [--out PATH] [--quiet]
"""
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import ssl
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

API_BASE = "https://mimo-server-cn.xiaomimimo.com/api"
COOKIE_DB = os.path.expanduser(
    "~/Library/Application Support/Xiaomi MiMo/Partitions/xiaomi-account/Cookies"
)
DEFAULT_OUT = os.path.expanduser("~/.cache/quotadock/mimo-usage.json")
UA = "miaccount_desktop"
CTX = ssl.create_default_context()


def load_pass_cookies() -> dict[str, str]:
    if not os.path.exists(COOKIE_DB):
        raise SystemExit(f"cookie db not found: {COOKIE_DB}")
    con = sqlite3.connect(f"file:{COOKIE_DB}?mode=ro", uri=True)
    try:
        rows = con.execute("select name,value from cookies").fetchall()
    finally:
        con.close()
    ck = {n: v for n, v in rows if v}
    for need in ("passToken", "userId"):
        if need not in ck:
            raise SystemExit(f"missing cookie {need}; login to Xiaomi MiMo Desktop first")
    return ck


def parse_set_cookie(raw: str) -> tuple[str, str] | None:
    if not raw or "=" not in raw:
        return None
    name, rest = raw.split("=", 1)
    name = name.strip()
    if not name or not name[0].isalpha():
        return None
    return name, rest.split(";", 1)[0]


def walk(url: str, seed: dict[str, str], max_redir: int = 10) -> tuple[int, bytes, dict[str, str]]:
    """Follow redirects (http→https upgraded), merging Set-Cookie into the jar."""
    cookies = dict(seed)
    for _ in range(max_redir):
        headers = {
            "User-Agent": UA,
            "Accept": "application/json",
            "X-Client-Version": "26.1010.101546",
            "X-Mimo-Source": "mimocode-cli-free",
        }
        if cookies:
            headers["Cookie"] = "; ".join(f"{k}={v}" for k, v in cookies.items())
        req = urllib.request.Request(url, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=15, context=CTX) as resp:
                for raw in resp.headers.get_all("Set-Cookie") or []:
                    kv = parse_set_cookie(raw)
                    if kv:
                        cookies[kv[0]] = kv[1]
                return resp.status, resp.read(), cookies
        except urllib.error.HTTPError as e:
            for raw in e.headers.get_all("Set-Cookie") or []:
                kv = parse_set_cookie(raw)
                if kv:
                    cookies[kv[0]] = kv[1]
            loc = e.headers.get("Location")
            if loc and e.code in (301, 302, 303, 307, 308):
                if loc.startswith("http://"):
                    loc = "https://" + loc[len("http://"):]
                url = urllib.parse.urljoin(url, loc)
                continue
            return e.code, e.read() or b"", cookies
    raise RuntimeError(f"too many redirects for {url}")


def fetch_json(path: str, cookies: dict[str, str]) -> dict:
    status, body, _ = walk(API_BASE + path, cookies)
    if status != 200:
        raise RuntimeError(f"{path} HTTP {status}: {body[:200]!r}")
    obj = json.loads(body.decode("utf-8"))
    if obj.get("code") not in (0, None):
        raise RuntimeError(f"{path} code={obj.get('code')} {obj.get('message')}")
    return obj.get("data") or {}


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--out", default=DEFAULT_OUT)
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    seed = load_pass_cookies()
    # 任一业务接口都会 302→account.xiaomi.com（sid=mimopc）→/api/sts 换 serviceToken
    status, _, cookies = walk(API_BASE + "/user/xiaomi/me", seed)
    if status != 200:
        raise SystemExit(f"SSO failed: HTTP {status}")

    usage = fetch_json("/user/usage", cookies)
    sub = fetch_json("/user/xiaomi/subscription/self", cookies)
    me_status, me_body, _ = walk(API_BASE + "/user/xiaomi/me", cookies)
    me = json.loads(me_body.decode()).get("data") or {} if me_status == 200 else {}

    # 官方 percent = 剩余百分比（UI 文案 remainingPercent）
    remaining = float(usage.get("percent") or 0)
    used = max(0.0, min(100.0, 100.0 - remaining))
    current = sub.get("current") or {}
    payload = {
        "ok": True,
        "fetchedAt": int(time.time()),
        "userId": me.get("userId") or seed.get("userId"),
        "nickname": me.get("nickname"),
        "usage": {
            "remainingPercent": remaining,
            "usedPercent": round(used, 1),
            "resetDate": usage.get("resetDate"),
            "resetAt": usage.get("resetAt"),
        },
        "subscription": {
            "planCode": current.get("planCode"),
            "title": current.get("title"),
            "planTier": current.get("planTier"),
            "status": current.get("status"),
            "renewalMode": current.get("renewalMode"),
            "percent": current.get("percent"),
            "nextResetTime": current.get("nextResetTime"),
            "endTime": current.get("endTime"),
        },
        "source": "mimo-usage-sync",
    }

    out = os.path.expanduser(args.out)
    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
    tmp = out + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, out)
    os.chmod(out, 0o600)

    if not args.quiet:
        print(
            f"ok used={used:.1f}% remaining={remaining:.1f}% "
            f"plan={payload['subscription'].get('title') or payload['subscription'].get('planCode')} "
            f"reset={usage.get('resetDate')} -> {out}"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
