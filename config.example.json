{
  "language": "zh",
  "timezone": "Asia/Shanghai",
  "refreshIntervalSeconds": 180,
  "thresholds": {
    "yellow": 60,
    "red": 85
  },
  "zhipu": {
    "providerConfigPath": "~/.zcode/v2/provider_config.json",
    "credentialsPath": "~/.zcode/v2/credentials.json",
    "names": {
      "bigmodel-api-2": "周卡",
      "bigmodel-api": "新卡"
    },
    "keys": [
      {
        "name": "my-key",
        "id": "backup",
        "key": "xxxxxxxxxxxxxxxx.yyyyyyyy"
      }
    ]
  },
  "codex": {
    "enabled": true,
    "authPath": "~/.codex/auth.json",
    "proxyHost": "127.0.0.1",
    "proxyPort": 6152,
    "retries": 4,
    "retryIntervalSeconds": 15,
    "refreshIntervalSeconds": 180
  },
  "kimi": {
    "enabled": true,
    "credentialsPath": "~/.kimi-code/credentials/kimi-code.json",
    "refreshIntervalSeconds": 180
  },
  "mimo": {
    "enabled": true,
    "cachePath": "~/.cache/quotadock/mimo-usage.json",
    "refreshIntervalSeconds": 180
  },
  "claudeCode": {
    "sshConnectTimeout": 6,
    "refreshUsage": true,
    "local": {
      "enabled": true,
      "path": "~/.claude.json",
      "refreshUsage": true,
      "extraProfiles": [
        {
          "name": "et",
          "path": "~/.claude-profiles/et/.claude.json",
          "refreshUsage": true,
          "claudePath": "~/.local/share/claude-et/versions/2.1.300"
        }
      ]
    },
    "servers": [
      {
        "host": "my-vps",
        "name": "vps1",
        "sshPort": "",
        "user": "",
        "paths": [
          "/home/claude/.claude.json",
          "/root/.claude.json"
        ]
      }
    ],
    "refreshIntervalSeconds": 600,
    "sshMultiplexing": true
  },
  "magpie": {
    "enabled": true,
    "binPath": "",
    "providers": ["cursor"],
    "refreshIntervalSeconds": 180
  },
  "autoPing": {
    "enabled": false,
    "command": "/opt/homebrew/bin/glm-ping"
  }
}